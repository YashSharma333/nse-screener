# ──────────────────────────────────────────────────────────────
# NSE Screener — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your local
# or production MySQL instance.
# ──────────────────────────────────────────────────────────────

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=nse_screener

# Logging (optional — defaults to INFO)
# LOG_LEVEL=DEBUG

# MCP servers (see README, "MCP servers")
# Read-only MySQL user used by the MySQL MCP server (never the root user).
MYSQL_READONLY_USER=nse_readonly
MYSQL_READONLY_PASSWORD=
# Fine-grained GitHub token for the GitHub MCP server.
GITHUB_PERSONAL_ACCESS_TOKEN=
