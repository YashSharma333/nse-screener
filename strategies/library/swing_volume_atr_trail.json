{
  "name": "Swing Volume ATR Trailing",
  "version": "1.0",
  "description": "Trend alignment with volume surge entry, 2.0x ATR initial stop, and dynamic 2.0x ATR trailing ratchet with breakeven at 1.5R.",
  "author": "trader",
  "status": "candidate",
  "entry": {
    "inline_rules": [
      "ema_20 > sma_50",
      "sma_50 > sma_200",
      "close > sma_50",
      "close > sma_200",
      "close >= 0.85 * high_252d_prev",
      "vol_multiple > 1.5",
      "volume_sma_20 > 250000",
      "rsi_14 < 70"
    ]
  },
  "exit": {
    "stop_loss_type": "atr",
    "stop_loss_value": 2.0,
    "target_type": "none",
    "target_value": null,
    "trailing_stop_type": "atr",
    "trailing_stop_value": 2.0,
    "move_to_breakeven_at_r": 1.5,
    "max_holding_days": 20,
    "exit_rules": []
  },
  "sizing": {
    "risk_percent": 1.0,
    "fixed_amount": 50000.0,
    "max_positions": 5,
    "max_portfolio_heat_percent": 5.0
  },
  "costs": {
