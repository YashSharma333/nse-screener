{
  "name": "RSI Momentum Swing Trail",
  "version": "1.0",
  "description": "Fast momentum shift strategy (RSI 9 > WMA 21 of RSI 9) with 4% initial stop, 3% trailing stop, and 8% percentage target.",
  "author": "trader",
  "status": "candidate",
  "entry": {
    "condition": {
      "type": "group",
      "mode": "all",
      "children": [
        {"type": "compare", "op": ">", "left": {"type": "indicator", "name": "ema", "params": {"length": 20}, "days_ago": 0}, "right": {"type": "indicator", "name": "sma", "params": {"length": 50}, "days_ago": 0}},
        {"type": "compare", "op": ">", "left": {"type": "indicator", "name": "sma", "params": {"length": 50}, "days_ago": 0}, "right": {"type": "indicator", "name": "sma", "params": {"length": 200}, "days_ago": 0}},
        {"type": "compare", "op": ">", "left": {"type": "field", "name": "close", "days_ago": 0}, "right": {"type": "indicator", "name": "sma", "params": {"length": 50}, "days_ago": 0}},
        {"type": "compare", "op": ">", "left": {"type": "field", "name": "close", "days_ago": 0}, "right": {"type": "indicator", "name": "sma", "params": {"length": 200}, "days_ago": 0}},
        {"type": "compare", "op": ">=", "left": {"type": "field", "name": "close", "days_ago": 0}, "right": {"type": "math", "op": "*", "left": {"type": "number", "value": 0.85}, "right": {"type": "window", "stat": "max", "length": 252, "source": {"type": "field", "name": "high", "days_ago": 0}, "days_ago": 1}}},
        {"type": "compare", "op": ">", "left": {"type": "field", "name": "volume", "days_ago": 0}, "right": {"type": "math", "op": "*", "left": {"type": "number", "value": 1.5}, "right": {"type": "indicator", "name": "sma", "params": {"length": 20}, "days_ago": 1, "source": {"type": "field", "name": "volume", "days_ago": 0}}}},
        {"type": "compare", "op": ">", "left": {"type": "indicator", "name": "sma", "params": {"length": 20}, "days_ago": 0, "source": {"type": "field", "name": "volume", "days_ago": 0}}, "right": {"type": "number", "value": 250000}},
        {"type": "compare", "op": ">=", "left": {"type": "indicator", "name": "rsi", "params": {"length": 9}, "days_ago": 0}, "right": {"type": "math", "op": "+", "left": {"type": "indicator", "name": "wma", "params": {"length": 21}, "days_ago": 0, "source": {"type": "indicator", "name": "rsi", "params": {"length": 9}, "days_ago": 0}}, "right": {"type": "number", "value": 1.1}}},
        {"type": "compare", "op": ">=", "left": {"type": "indicator", "name": "rsi", "params": {"length": 9}, "days_ago": 0}, "right": {"type": "number", "value": 45}},
        {"type": "compare", "op": "<=", "left": {"type": "indicator", "name": "rsi", "params": {"length": 9}, "days_ago": 0}, "right": {"type": "number", "value": 65}}
      ]
    }
  },
  "exit": {
    "stop_loss_type": "percentage",
    "stop_loss_value": 4.0,
    "target_type": "percentage",
    "target_value": 8.0,
    "trailing_stop_type": "percentage",
    "trailing_stop_value": 3.0,
    "move_to_breakeven_at_r": null,
    "max_holding_days": 12,
    "exit_rules": []
  },
  "sizing": {
    "risk_percent": 1.0,
    "fixed_amount": 50000.0,
    "max_positions": 5,
    "max_portfolio_heat_percent": 5.0
  }
