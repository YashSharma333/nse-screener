# Python & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Logs
logs/
*.log

# Data (Keep out of source control)
data/raw/*
data/processed/*
data/corporate_actions/*
!data/corporate_actions/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated reports: keep the folder (via .gitkeep), never the files
reports/*
!reports/.gitkeep

# Scratch notes for GitHub issues
issue.md

# Packaging output
dist/
build/
*.egg-info/

# Environment Variables
.env
.env.local

# Claude Code personal overrides (the shared .claude/settings.json IS committed)
.claude/settings.local.json

# IDEs (VS Code, macOS specifics)
.vscode/
.DS_Store

# Streamlit
.streamlit/
.coverage
htmlcov/
.agents/
