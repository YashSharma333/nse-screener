{
  "name": "Swing Momentum 2R Fixed Target",
  "version": "1.0",
  "description": "Momentum surge entry with anti-exhaustion filter, 1.5x ATR initial stop, 2.0R profit target, and breakeven ratchet at 1.0R.",
  "author": "trader",
  "status": "candidate",
  "entry": {
    "inline_rules": [
      "ema_20 > sma_50",
      "sma_50 > sma_200",
      "close > sma_50",
      "close > sma_200",
      "close >= 0.85 * high_252d_prev",
      "vol_multiple > 1.5",
      "volume_sma_20 > 250000",
      "return_60d <= 40",
      "return_120d >= 30",
      "(close - close_252d) / close_180d * 100 <= 300",
      "(close - close_180d) / close_252d * 100 <= 300",
      "(close - close_180d) / close_252d * 100 >= 50"
    ]
  },
  "exit": {
    "stop_loss_type": "atr",
    "stop_loss_value": 1.5,
    "target_type": "rr_multiple",
    "target_value": 2.0,
    "trailing_stop_type": "none",
    "trailing_stop_value": null,
    "move_to_breakeven_at_r": 1.0,
    "max_holding_days": 15,
    "exit_rules": []
  },
  "sizing": {
    "risk_percent": 1.0,
    "fixed_amount": 50000.0,
    "max_positions": 5,
    "max_portfolio_heat_percent": 5.0
  },
  "costs": {
    "slippage_bps": 5.0,
    "dp_charge_per_scrip_day": 0.0,
    "exchange_turnover_rate": 3.07e-05,
    "sebi_turnover_rate": 1e-06,
    "stt_buy_rate": 0.001,
    "stt_sell_rate": 0.001,
    "stamp_duty_rate": 0.00015,
    "gst_rate": 0.18,
    "brokerage_per_order": 0.0,
    "stcg_tax_rate": 0.2
  }
}
