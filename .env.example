# ──────────────────────────────────────────────────────────────
# NSE Screener — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your local
# or production MySQL instance.
# ──────────────────────────────────────────────────────────────

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=nse_screener

# Logging (optional — defaults to INFO)
# LOG_LEVEL=DEBUG
