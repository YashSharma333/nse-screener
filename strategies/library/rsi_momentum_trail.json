{
  "name": "RSI Momentum Swing Trail",
  "version": "1.0",
  "description": "Fast momentum shift strategy (RSI 9 > WMA 21 of RSI 9) with 4% initial stop, 3% trailing stop, and 8% percentage target.",
  "author": "trader",
  "status": "candidate",
  "entry": {
    "inline_rules": [
      "ema_20 > sma_50",
      "sma_50 > sma_200",
      "close > sma_50",
      "close > sma_200",
      "close >= 0.85 * high_252d_prev",
      "vol_multiple > 1.5",
      "volume_sma_20 > 250000",
      "rsi_9 >= rsi_9_wma_21 + 1.1",
      "rsi_9 >= 45",
      "rsi_9 <= 65"
    ]
  },
  "exit": {
    "stop_loss_type": "percentage",
    "stop_loss_value": 4.0,
    "target_type": "percentage",
    "target_value": 8.0,
    "trailing_stop_type": "percentage",
    "trailing_stop_value": 3.0,
    "move_to_breakeven_at_r": null,
    "max_holding_days": 12,
    "exit_rules": []
  },
  "sizing": {
    "risk_percent": 1.0,
    "fixed_amount": 50000.0,
    "max_positions": 5,
    "max_portfolio_heat_percent": 5.0
  },
  "costs": {
